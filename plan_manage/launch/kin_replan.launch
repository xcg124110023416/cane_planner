<launch>
    <!-- Planner-3 geometry, coverage-driven corridors and independent preview. -->
    <arg name="convex_corridor_adaptive_sampling" default="true"/>
    <arg name="convex_corridor_planning_length" default="8.0"/>
    <arg name="global_replan_period" default="0.2"/>
    <arg name="convex_corridor_preview_enabled" default="true"/>
    <arg name="convex_corridor_preview_length" default="20.0"/>
    <arg name="convex_corridor_preview_period" default="0.2"/>
    <arg name="human_cane_enabled" default="true"/>
    <arg name="human_cane_body_radius" default="0.25"/>
    <arg name="human_cane_cane_length" default="0.65"/>
    <arg name="human_cane_front_radius" default="0.12"/>
    <arg name="human_cane_margin" default="0.03"/>
    <arg name="pedestrian_body_margin" default="0.03"/>
    <arg name="pedestrian_social_radius" default="0.4"/>

    <arg name="planner" default="2"/>
    <!-- Enable only with an actual detector source; missing data fails closed. -->
    <arg name="use_pedestrians" default="false"/>
    <!-- Planner 3: soft preference only; 1x penalty over 0.8 m additional clearance. -->
    <arg name="astar_w_clearance" default="$(eval 1.0 if arg('planner') == 3 else 0.0)"/>
    <arg name="astar_clearance_sigma" default="0.8"/>
    <!-- odom from vins estimator-->
    <!-- <arg name="odometry_topic" value="/plvins_estimator/odometry" /> -->
    <!-- odom from fast-lio -->
    <arg name="odometry_topic" value="/Odometry" />
    <arg name="convex_corridor_local_radius" default="3.0"/>
    <arg name="convex_corridor_max_segment_length" default="1.0"/>

    <include file="$(find realsense2_camera)/launch/rs_rgbd.launch"/>
    <include file="$(find plan_manage)/launch/include/fasterlio.launch"/>
    <!-- kindynameic alogoritm -->
    <include file="$(find plan_manage)/launch/include/algorithm.launch">
        <!-- choose planner A*:1 kin:2 -->
        <arg name="planner" value="$(arg planner)"/>
        <arg name="convex_corridor_adaptive_sampling" value="$(arg convex_corridor_adaptive_sampling)"/>
        <arg name="convex_corridor_planning_length" value="$(arg convex_corridor_planning_length)"/>
        <arg name="global_replan_period" value="$(arg global_replan_period)"/>
        <arg name="convex_corridor_preview_enabled" value="$(arg convex_corridor_preview_enabled)"/>
        <arg name="convex_corridor_preview_length" value="$(arg convex_corridor_preview_length)"/>
        <arg name="convex_corridor_preview_period" value="$(arg convex_corridor_preview_period)"/>
        <arg name="human_cane_enabled" value="$(arg human_cane_enabled)"/>
        <arg name="human_cane_body_radius" value="$(arg human_cane_body_radius)"/>
        <arg name="human_cane_cane_length" value="$(arg human_cane_cane_length)"/>
        <arg name="human_cane_front_radius" value="$(arg human_cane_front_radius)"/>
        <arg name="human_cane_margin" value="$(arg human_cane_margin)"/>
        <arg name="pedestrian_body_margin" value="$(arg pedestrian_body_margin)"/>
        <arg name="pedestrian_social_radius" value="$(arg pedestrian_social_radius)"/>

        <arg name="use_pedestrians" value="$(arg use_pedestrians)"/>
        <arg name="astar_w_clearance" value="$(arg astar_w_clearance)"/>
        <arg name="astar_clearance_sigma" value="$(arg astar_clearance_sigma)"/>
        <!-- odom -->
        <arg name="odometry_world" value = "$(arg odometry_topic)"/>
        <!-- using depth and odom -->
        <arg name="depth_topic" value="/camera/aligned_depth_to_color/image_raw"/>
        <arg name="sensor_pose_topic" value="/plvins_estimator/camera_pose"/>
        <!-- using cloud and odom -->
        <arg name="odometry_topic" value = "$(arg odometry_topic)"/>
        <arg name="cloud_topic" value = "/cloud_registered"/>
        <!-- experice set -->
        <arg name="simulation" value="false"/>
        <arg name="collision_margin" value="0.1"/>
        <arg name="slice_height" value="0.0"/>
        <arg name="kin_horizon" value="5.0"/>
        <arg name="convex_corridor_local_radius" value="$(arg convex_corridor_local_radius)"/>
        <arg name="convex_corridor_max_segment_length" value="$(arg convex_corridor_max_segment_length)"/>
        <!-- map size -->
        <arg name="map_size_x" value="100.0"/>
        <arg name="map_size_y" value="50.0"/>
        <arg name="map_size_z" value="4.0"/>
    </include>
    <!-- L1 controller -->
    <node pkg="plan_ctrl" type="L1_controller_v2" respawn="false" name="L1_controller_v2" output="screen">
        <!-- <node pkg="plan_ctrl" type="L1_controller_v2" respawn="false" name="L1_controller_v2">        -->
        <param name="Vcmd" value="0.5" />
        <param name="baseSpeed" value="100"/>
        <param name="baseAngle" value="0.0"/>
        <!-- <param name="AngleGain" value="-2.0"/> -->
        <param name="controller_freq" value="15"/>
        <param name="SerialUsing" value="true"/>
        <!-- 调试时，需要改成/dev/ttyACM0 -->
        <!-- /dev/feedback_controller -->
        <param name="port" value="/dev/ttyACM0"/>
        <remap from="/odometry/filtered" to="$(arg odometry_topic)" />
    </node>
</launch>
