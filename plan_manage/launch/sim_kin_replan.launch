<launch>
    <arg name="odometry_topic" value = "/simulation_generator/odom"/>
    <arg name="planner" default="2"/>  <!-- A*:1, kinodynamic:2, LFPC-MPPI:3, kinematic MPPI:4 -->
    <!-- MPC ablation switches for lightweight simulation. -->
    <arg name="mpc_w_risk" default="0.0"/>
    <arg name="mpc_enable_cpa" default="false"/>
    <arg name="mpc_enable_stop_enforce" default="true"/>
    <arg name="mpc_enable_stop_advice" default="true"/>
    <arg name="mpc_cpa_weight" default="0.6"/>
    <arg name="mpc_risk_sigma_y" default="0.4"/>
    <arg name="mpc_num_samples" default="200"/>
    <arg name="global_wp_arrival_radius" default="0.25"/>
    <!-- Optional full-PCD global map for A*. Keep local SDF for MPC. -->
    <arg name="mpc_enable_dynamic_hard_reject" default="false"/>
    <arg name="mpc_enable_interaction" default="true"/>
    <arg name="mpc_interaction_enable_yield" default="false"/>
    <arg name="mpc_interaction_st_horizon" default="4.0"/>
    <arg name="mpc_interaction_yield_trigger_time" default="2.5"/>
    <arg name="mpc_interaction_robot_radius" default="0.25"/>
    <arg name="mpc_interaction_yield_safety_margin" default="0.20"/>
    <arg name="mpc_interaction_front_min" default="0.3"/>
    <arg name="mpc_interaction_front_max" default="4.0"/>
    <arg name="mpc_interaction_corridor_width" default="0.7"/>
    <arg name="mpc_interaction_cross_speed" default="0.15"/>
    <arg name="mpc_interaction_time_gap" default="0.8"/>
    <arg name="mpc_interaction_min_robot_speed" default="0.15"/>
    <arg name="mpc_interaction_cpa_horizon" default="3.0"/>
    <arg name="mpc_interaction_cpa_dist" default="0.8"/>
    <arg name="mpc_interaction_use_cpa_check" default="true"/>
    <arg name="mpc_interaction_stop_release_clear_time" default="0.15"/>
    <arg name="mpc_interaction_post_yield_grace_time" default="0.6"/>
    <arg name="mpc_corridor_stop_valid_ratio_threshold" default="0.2"/>
    <!-- Corridor centreline source: the previous MPPI prediction while it stays
         within dwc_spine_route_deviation of the route, the route once it does
         not. true pins it to the route unconditionally. -->
    <arg name="dwc_spine_prefer_global" default="false"/>
    <arg name="dwc_spine_route_deviation" default="0.6"/>
    <arg name="intervention_enable" default="false"/>
    <arg name="intervention_method" default="ours"/>
    <arg name="intervention_corridor_tolerance" default="0.02"/>
    <arg name="intervention_lateral_safety_only" default="true"/>
    <arg name="intervention_p_safe" default="0.8"/>
    <arg name="intervention_min_candidate_margin" default="0.0"/>
    <arg name="intervention_eta_warn" default="0.25"/>
    <arg name="intervention_T_warn" default="0.5"/>
    <!-- GUIDANCE gate, fitted on ours_pilot7 (see
         .trellis/tasks/08-31-autonomy-intervention-v1/research/):
         J_safe* rises monotonically with danger (0.002 at >4 s from a corridor
         exit, 0.073 below 0.5 s), so 0.06 fires on ~9% of frames about 0.7 s
         ahead. T_autonomy turned out NOT to be monotone in lead time, so its
         threshold is deliberately permissive (rollout horizon is 3.5 s) and no
         longer blocks the gate. -->
    <arg name="intervention_T_guide" default="4.0"/>
    <arg name="intervention_J_guide" default="0.06"/>
    <!-- Intervention time constants are in seconds of WALKING (see
         algorithm.launch): the layer advances by lfpc/t_sup per applied step, so
         they mean the same thing in simulation and on hardware. -->
    <arg name="intervention_guide_hold_time" default="1.0"/>
    <arg name="intervention_guide_lookahead" default="1.0"/>
    <arg name="intervention_T_stop" default="0.1"/>
    <!-- These two were tuned as *frame counts* against the old wall clock (5 and
         10 FSM ticks at 0.1 s). Now that the layer is clocked by the walk, the
         same 5 / 10 gait decisions are 1.75 s and 3.5 s. Leaving them at 0.5 /
         1.0 would silently shrink STOP confirmation to 2 steps: on
         ours_pilot9.bag that turns 8 of 15 transient danger runs into a STOP,
         including single-frame glitches. -->
    <arg name="intervention_stop_entry_window" default="1.75"/>
    <arg name="intervention_stop_release_window" default="3.5"/>
    <arg name="intervention_stop_entry_vote_ratio" default="0.8"/>
    <arg name="intervention_stop_release_vote_ratio" default="0.8"/>
    <arg name="intervention_heading_reaction_delay" default="0.35"/>
    <arg name="intervention_heading_compliance" default="0.6"/>
    <!-- 10 deg. The native planner reaches every goal on these routes with
         |api| mean 2.5 deg / p90 5.0 deg / max 8.4 deg per step (ours_pilot11);
         the old 30 deg cap was 6x that p90 and the response spent 47% of its
         steps above 15 deg, bending the executed path hard enough that the
         corridor built from it curved too and only curving samples stayed
         feasible: 8.96 revolutions in ours_pilot10. -->
    <arg name="intervention_max_heading_correction" default="0.174532925199"/>
    <!-- Largest change in the applied correction per step, so a cue ramps in over
         ~2 steps instead of stepping to full deflection. Native step-to-step
         change is p90 5.7 deg. Release is not rate limited: with no active cue
         the design requires api to be exactly 0. -->
    <arg name="intervention_heading_rate_limit" default="0.1"/>
    <arg name="intervention_require_native_valid" default="true"/>
    <arg name="intervention_guide_route_weight" default="1.0"/>
    <arg name="intervention_stop_reaction_delay" default="0.35"/>
    <arg name="convex_corridor_enable" default="false"/>
    <arg name="map_odom_override_topic" default="/sim_odom"/>
    <arg name="convex_corridor_segment_length" default="0.8"/>
    <arg name="convex_corridor_half_width" default="0.45"/>
    <arg name="convex_corridor_min_half_width" default="0.25"/>
    <arg name="convex_corridor_static_sample_ds" default="0.2"/>
    <arg name="convex_corridor_static_sample_dl" default="0.1"/>
    <arg name="convex_corridor_pedestrian_radius" default="0.35"/>
    <arg name="convex_corridor_pedestrian_time_margin" default="0.4"/>
    <arg name="convex_corridor_start_grace_length" default="0.4"/>
    <arg name="pedestrian_scenario" default="mixed"/>
    <arg name="use_static_global_map" default="false"/>
    <arg name="use_static_global_esdf" default="false"/>
    <arg name="static_map_pcd" default="$(find map_generator)/resource/office2_modify.pcd"/>
    <arg name="static_map_min_height" default="0.60"/>
    <arg name="static_map_max_height" default="2.0"/>
    <arg name="static_map_inflation" default="0.08"/>
    <arg name="static_map_min_points_per_cell" default="3"/>
    <arg name="static_map_min_component_cells" default="6"/>
    <arg name="static_require_known_region" default="true"/>
    <arg name="static_known_use_enclosed_region" default="true"/>
    <arg name="static_known_min_height" default="-0.25"/>
    <arg name="static_known_max_height" default="0.35"/>
    <arg name="static_known_inflation" default="0.55"/>
    <arg name="static_known_boundary_inflation" default="0.35"/>
    <arg name="static_endpoint_clear_radius" default="0.25"/>
    <arg name="astar_w_clearance" default="0.25"/>
    <arg name="astar_clearance_sigma" default="0.8"/>
    <arg name="astar_min_clearance" default="0.0"/>
    <arg name="astar_traversable_radius" default="0.25"/>
    <arg name="publish_static_map_debug" default="true"/>
    <!-- simulation -->
    <include file="$(find plan_manage)/launch/include/simulation.launch"/>
    <!-- unified planner (A*/kinodynamic/MPC all via kin_replan_node FSM) -->
    <include file="$(find plan_manage)/launch/include/algorithm.launch">
        <arg name="planner" value="$(arg planner)"/>
        <arg name="odometry_topic" value = "$(arg odometry_topic)"/>
        <arg name="odometry_world" value = "$(arg odometry_topic)"/>
        <arg name="cloud_topic" value = "/simulation_generator/global_cloud"/>
        <arg name="depth_topic" value="depth"/>
        <arg name="sensor_pose_topic" value="pose"/>
        <arg name="simulation" value="true"/>
        <arg name="slice_height" value="0.0"/>
        <arg name="collision_margin" value="0.2"/>
        <arg name="kin_horizon" value="200.0"/>
        <arg name="global_wp_arrival_radius" value="$(arg global_wp_arrival_radius)"/>
        <arg name="map_size_x" value="40.0"/>
        <arg name="map_size_y" value="40.0"/>
        <arg name="map_size_z" value="5.0"/>
        <arg name="mpc_w_risk" value="$(arg mpc_w_risk)"/>
        <arg name="mpc_enable_cpa" value="$(arg mpc_enable_cpa)"/>
        <arg name="mpc_cpa_weight" value="$(arg mpc_cpa_weight)"/>
        <arg name="mpc_risk_sigma_y" value="$(arg mpc_risk_sigma_y)"/>
        <arg name="mpc_num_samples" value="$(arg mpc_num_samples)"/>
        <arg name="mpc_enable_stop_enforce" value="$(arg mpc_enable_stop_enforce)"/>
        <arg name="mpc_enable_stop_advice" value="$(arg mpc_enable_stop_advice)"/>
        <arg name="mpc_enable_dynamic_hard_reject" value="$(arg mpc_enable_dynamic_hard_reject)"/>
        <arg name="mpc_enable_interaction" value="$(arg mpc_enable_interaction)"/>
        <arg name="mpc_interaction_enable_yield" value="$(arg mpc_interaction_enable_yield)"/>
        <arg name="mpc_interaction_st_horizon" value="$(arg mpc_interaction_st_horizon)"/>
        <arg name="mpc_interaction_yield_trigger_time" value="$(arg mpc_interaction_yield_trigger_time)"/>
        <arg name="mpc_interaction_robot_radius" value="$(arg mpc_interaction_robot_radius)"/>
        <arg name="mpc_interaction_yield_safety_margin" value="$(arg mpc_interaction_yield_safety_margin)"/>
        <arg name="mpc_interaction_front_min" value="$(arg mpc_interaction_front_min)"/>
        <arg name="mpc_interaction_front_max" value="$(arg mpc_interaction_front_max)"/>
        <arg name="mpc_interaction_corridor_width" value="$(arg mpc_interaction_corridor_width)"/>
        <arg name="mpc_interaction_cross_speed" value="$(arg mpc_interaction_cross_speed)"/>
        <arg name="mpc_interaction_time_gap" value="$(arg mpc_interaction_time_gap)"/>
        <arg name="mpc_interaction_min_robot_speed" value="$(arg mpc_interaction_min_robot_speed)"/>
        <arg name="mpc_interaction_cpa_horizon" value="$(arg mpc_interaction_cpa_horizon)"/>
        <arg name="mpc_interaction_cpa_dist" value="$(arg mpc_interaction_cpa_dist)"/>
        <arg name="mpc_interaction_use_cpa_check" value="$(arg mpc_interaction_use_cpa_check)"/>
        <arg name="mpc_interaction_stop_release_clear_time" value="$(arg mpc_interaction_stop_release_clear_time)"/>
        <arg name="mpc_interaction_post_yield_grace_time" value="$(arg mpc_interaction_post_yield_grace_time)"/>
        <arg name="mpc_corridor_stop_valid_ratio_threshold" value="$(arg mpc_corridor_stop_valid_ratio_threshold)"/>
        <arg name="dwc_spine_prefer_global" value="$(arg dwc_spine_prefer_global)"/>
        <arg name="dwc_spine_route_deviation" value="$(arg dwc_spine_route_deviation)"/>
        <arg name="intervention_enable" value="$(arg intervention_enable)"/>
        <arg name="intervention_method" value="$(arg intervention_method)"/>
        <arg name="intervention_corridor_tolerance" value="$(arg intervention_corridor_tolerance)"/>
        <arg name="intervention_lateral_safety_only" value="$(arg intervention_lateral_safety_only)"/>
        <arg name="intervention_p_safe" value="$(arg intervention_p_safe)"/>
        <arg name="intervention_min_candidate_margin" value="$(arg intervention_min_candidate_margin)"/>
        <arg name="intervention_eta_warn" value="$(arg intervention_eta_warn)"/>
        <arg name="intervention_T_warn" value="$(arg intervention_T_warn)"/>
        <arg name="intervention_T_guide" value="$(arg intervention_T_guide)"/>
        <arg name="intervention_J_guide" value="$(arg intervention_J_guide)"/>
        <arg name="intervention_guide_hold_time" value="$(arg intervention_guide_hold_time)"/>
        <arg name="intervention_guide_lookahead" value="$(arg intervention_guide_lookahead)"/>
        <arg name="intervention_T_stop" value="$(arg intervention_T_stop)"/>
        <arg name="intervention_stop_entry_window" value="$(arg intervention_stop_entry_window)"/>
        <arg name="intervention_stop_release_window" value="$(arg intervention_stop_release_window)"/>
        <arg name="intervention_stop_entry_vote_ratio" value="$(arg intervention_stop_entry_vote_ratio)"/>
        <arg name="intervention_stop_release_vote_ratio" value="$(arg intervention_stop_release_vote_ratio)"/>
        <arg name="intervention_heading_reaction_delay" value="$(arg intervention_heading_reaction_delay)"/>
        <arg name="intervention_heading_compliance" value="$(arg intervention_heading_compliance)"/>
        <arg name="intervention_max_heading_correction" value="$(arg intervention_max_heading_correction)"/>
        <arg name="intervention_heading_rate_limit" value="$(arg intervention_heading_rate_limit)"/>
        <arg name="intervention_require_native_valid" value="$(arg intervention_require_native_valid)"/>
        <arg name="intervention_guide_route_weight" value="$(arg intervention_guide_route_weight)"/>
        <arg name="intervention_stop_reaction_delay" value="$(arg intervention_stop_reaction_delay)"/>
        <arg name="convex_corridor_enable" value="$(arg convex_corridor_enable)"/>
        <arg name="map_odom_override_topic" value="$(arg map_odom_override_topic)"/>
        <arg name="convex_corridor_segment_length" value="$(arg convex_corridor_segment_length)"/>
        <arg name="convex_corridor_half_width" value="$(arg convex_corridor_half_width)"/>
        <arg name="convex_corridor_min_half_width" value="$(arg convex_corridor_min_half_width)"/>
        <arg name="convex_corridor_static_sample_ds" value="$(arg convex_corridor_static_sample_ds)"/>
        <arg name="convex_corridor_static_sample_dl" value="$(arg convex_corridor_static_sample_dl)"/>
        <arg name="convex_corridor_pedestrian_radius" value="$(arg convex_corridor_pedestrian_radius)"/>
        <arg name="convex_corridor_pedestrian_time_margin" value="$(arg convex_corridor_pedestrian_time_margin)"/>
        <arg name="convex_corridor_start_grace_length" value="$(arg convex_corridor_start_grace_length)"/>
        <arg name="use_static_global_map" value="$(arg use_static_global_map)"/>
        <arg name="use_static_global_esdf" value="$(arg use_static_global_esdf)"/>
        <arg name="static_map_pcd" value="$(arg static_map_pcd)"/>
        <arg name="static_map_min_height" value="$(arg static_map_min_height)"/>
        <arg name="static_map_max_height" value="$(arg static_map_max_height)"/>
        <arg name="static_map_inflation" value="$(arg static_map_inflation)"/>
        <arg name="static_map_min_points_per_cell" value="$(arg static_map_min_points_per_cell)"/>
        <arg name="static_map_min_component_cells" value="$(arg static_map_min_component_cells)"/>
        <arg name="static_require_known_region" value="$(arg static_require_known_region)"/>
        <arg name="static_known_use_enclosed_region" value="$(arg static_known_use_enclosed_region)"/>
        <arg name="static_known_min_height" value="$(arg static_known_min_height)"/>
        <arg name="static_known_max_height" value="$(arg static_known_max_height)"/>
        <arg name="static_known_inflation" value="$(arg static_known_inflation)"/>
        <arg name="static_known_boundary_inflation" value="$(arg static_known_boundary_inflation)"/>
        <arg name="static_endpoint_clear_radius" value="$(arg static_endpoint_clear_radius)"/>
        <arg name="astar_w_clearance" value="$(arg astar_w_clearance)"/>
        <arg name="astar_clearance_sigma" value="$(arg astar_clearance_sigma)"/>
        <arg name="astar_min_clearance" value="$(arg astar_min_clearance)"/>
        <arg name="astar_traversable_radius" value="$(arg astar_traversable_radius)"/>
        <arg name="publish_static_map_debug" value="$(arg publish_static_map_debug)"/>
    </include>
    <!-- L1 controller -->
    <node pkg="plan_ctrl" type="L1_controller_v2" respawn="false" name="L1_controller_v2" output="screen">
        <param name="Vcmd" value="1.0" />
        <param name="baseSpeed" value="1425"/>
        <param name="baseAngle" value="90.0"/>
        <param name="AngleGain" value="-2"/>
        <param name="SerialUsing" value="false"/>
        <remap from="/odometry/filtered" to="$(arg odometry_topic)" />
    </node>
    <!-- waypoint -->
    <node pkg="waypoint_generator" name="waypoint_generator" type="waypoint_generator" output="screen">
        <remap from="~odom" to="$(arg odometry_topic)"/>
        <remap from="~goal" to="/move_base_simple/goal"/>
        <remap from="~traj_start_trigger" to="/traj_start_trigger" />
        <param name="waypoint_type" value="manual-lonely-waypoint"/>
    </node>

    <node pkg="tf2_ros" type="static_transform_publisher" name="body2cane_base" args="0 0 0 0 0 0 /base_link /cane_base" />

    <!-- pedestrian simulation (dynamic obstacles for MPC testing) -->
    <arg name="use_pedestrians" default="true"/>
    <group if="$(arg use_pedestrians)">
        <node pkg="plan_manage" type="pedestrian_sim.py" name="pedestrian_sim" output="screen">
            <!-- trigger mode: pedestrian stays at start, walks once on goal, then disappears.
                 loop mode repeats continuously. -->
            <param name="scenario" value="$(arg pedestrian_scenario)"/>
            <param name="scenario_config" value="$(find plan_manage)/config/pedestrian_scenarios.yaml"/>
        </node>
    </group>

    <!-- visualisation -->
    <include file="$(find plan_manage)/launch/rviz.launch"/>
</launch>
