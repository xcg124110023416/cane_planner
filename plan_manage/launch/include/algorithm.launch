<launch>
    <!-- topic -->
    <arg name="odometry_topic"/>
    <arg name="odometry_world"/>
    <arg name="cloud_topic"/>
    <arg name="depth_topic"/>
    <arg name="sensor_pose_topic"/>
    <!-- simulation param -->
    <arg name="simulation"/>
    <arg name="planner"/>
    <arg name="gazebo_sim" default="false"/>
    <arg name="map_simulation" default="false"/>  <!-- SDF map sync mode: false=cloud+odom, true=cloud+pose -->
    <arg name="slice_height"/>
    <arg name="collision_margin"/>

    <arg name="map_size_x"/>
    <arg name="map_size_y"/>
    <arg name="map_size_z"/>
    <arg name="kin_horizon"/>
    <arg name="user_step_length" default="0.40"/>
    <arg name="global_wp_arrival_radius" default="0.25"/>
    <arg name="input_min_height" default="0.15"/>
    <arg name="input_max_height" default="2.6"/>
    <arg name="enable_map_visualization" default="true"/>
    <arg name="use_static_global_map" default="false"/>
    <arg name="use_static_global_esdf" default="false"/>
    <arg name="static_map_pcd" default=""/>
    <arg name="static_map_min_height" default="0.60"/>
    <arg name="static_map_max_height" default="2.0"/>
    <arg name="static_map_inflation" default="0.08"/>
    <arg name="static_map_min_points_per_cell" default="3"/>
    <arg name="static_map_min_component_cells" default="6"/>
    <arg name="static_require_known_region" default="true"/>
    <arg name="static_known_use_enclosed_region" default="true"/>
    <arg name="static_known_min_height" default="-0.25"/>
    <arg name="static_known_max_height" default="0.35"/>
    <arg name="static_known_inflation" default="0.55"/>
    <arg name="static_known_boundary_inflation" default="0.35"/>
    <arg name="global_esdf_min_height" default="1.00"/>
    <arg name="global_esdf_max_height" default="2.0"/>
    <arg name="global_esdf_query_min_height" default="1.00"/>
    <arg name="global_esdf_query_max_height" default="1.8"/>
    <arg name="global_esdf_query_step" default="0.3"/>
    <arg name="global_esdf_inflation" default="0.20"/>
    <arg name="global_esdf_safe_distance" default="0.15"/>
    <arg name="global_esdf_min_points_per_cell" default="1"/>
    <arg name="static_endpoint_clear_radius" default="0.25"/>
    <arg name="publish_static_map_debug" default="true"/>
    <arg name="mpc_enable_cpa" default="false"/>
    <arg name="mpc_enable_stop_enforce" default="true"/>
    <arg name="mpc_enable_stop_advice" default="true"/>
    <arg name="mpc_w_risk" default="2.0"/>
    <arg name="mpc_cpa_weight" default="0.6"/>
    <arg name="mpc_risk_sigma_y" default="0.4"/>
    <arg name="mpc_num_samples" default="200"/>
    <arg name="mpc_enable_dynamic_hard_reject" default="true"/>
    <arg name="mpc_enable_interaction" default="true"/>
    <arg name="mpc_interaction_enable_pass_behind" default="true"/>
    <arg name="mpc_interaction_enable_yield" default="true"/>
    <arg name="mpc_interaction_enable_social_cost" default="false"/>
    <arg name="mpc_interaction_w_front_pass" default="0.0"/>
    <arg name="mpc_interaction_enable_behind_corridor" default="false"/>
    <arg name="mpc_interaction_w_behind_corridor" default="0.0"/>
    <arg name="mpc_interaction_social_corridor_width" default="0.8"/>
    <arg name="mpc_interaction_front_buffer" default="0.25"/>
    <arg name="mpc_interaction_target_dist_cap" default="3.0"/>
    <arg name="mpc_interaction_front_min" default="0.3"/>
    <arg name="mpc_interaction_front_max" default="4.0"/>
    <arg name="mpc_interaction_corridor_width" default="0.7"/>
    <arg name="mpc_interaction_cross_speed" default="0.15"/>
    <arg name="mpc_interaction_time_gap" default="0.8"/>
    <arg name="mpc_interaction_min_robot_speed" default="0.15"/>
    <arg name="mpc_interaction_cpa_horizon" default="3.0"/>
    <arg name="mpc_interaction_cpa_dist" default="0.8"/>
    <arg name="mpc_interaction_use_cpa_check" default="true"/>
    <arg name="mpc_interaction_cross_enter_threshold" default="0.7"/>
    <arg name="mpc_interaction_cross_exit_threshold" default="0.3"/>
    <arg name="mpc_interaction_cross_confirm_frames" default="3"/>
    <arg name="mpc_interaction_cross_clear_frames" default="3"/>
    <arg name="mpc_interaction_mode_confirm_frames" default="2"/>
    <arg name="mpc_interaction_candidate_latch_time" default="1.0"/>
    <arg name="mpc_interaction_stop_release_clear_time" default="0.15"/>
    <arg name="mpc_interaction_post_yield_grace_time" default="0.6"/>
    <arg name="mpc_interaction_pass_behind_clear_time" default="0.7"/>
    <arg name="mpc_interaction_pass_behind_hold_time" default="0.6"/>
    <arg name="mpc_interaction_risk_low" default="0.3"/>
    <arg name="mpc_interaction_behind_dist" default="0.8"/>
    <arg name="mpc_interaction_forward_bias" default="0.6"/>
    <arg name="mpc_interaction_target_front_min" default="0.4"/>
    <arg name="mpc_interaction_target_front_max" default="3.5"/>
    <arg name="mpc_interaction_target_lateral_max" default="1.8"/>
    <arg name="mpc_interaction_target_ped_clearance" default="0.7"/>

    
    <node pkg="plan_manage" name="kin_replan_node" type="kin_replan_node" output="screen" >
        <remap from ="/map_ros/odom"  to = "$(arg odometry_topic)"/>
        <remap from ="/map_ros/cloud" to = "$(arg cloud_topic)"/>
        <remap from ="/map_ros/depth" to = "$(arg depth_topic)"/>
        <remap from ="/map_ros/pose"  to = "$(arg sensor_pose_topic)"/>
        <remap from="/odom_world" to="$(arg odometry_world)"/>

        <!-- planner manager -->
        <param name="manager/sim_speed" value="1.0" type="double"/>
        <param name="manager/global_wp_spacing" value="1.0" type="double"/>
        <param name="manager/global_wp_arrival_radius" value="$(arg global_wp_arrival_radius)" type="double"/>
        <!-- 前向截断距离：从最近投影点向前看多少米选为当前目标 -->
        <param name="manager/lookahead_dist" value="2.2" type="double"/>
        <param name="manager/max_vel" value="1.0" type="double"/>
        <param name="manager/max_acc" value="2.0" type="double"/>
        <param name="manager/max_jerk" value="4" type="double"/>
        <param name="manager/dynamic_environment" value="0" type="int"/>
        <param name="manager/local_segment_length" value="6.0" type="double"/>
        <param name="manager/clearance_threshold" value="0.2" type="double"/>
        <param name="manager/control_points_distance" value="0.35" type="double"/>
        <!-- planning fsm -->
        <param name="fsm/thresh_replan" value="1.0" type="double"/>
        <param name="fsm/thresh_no_replan" value="0.5" type="double"/>

        <!-- simulation true or false -->
        <param name="planner_node/simulation" value="$(arg simulation)"/>
        <param name="planner_node/gazebo_sim" value="$(arg gazebo_sim)" type="bool"/>
        <param name="planner_node/planner" value="$(arg planner)"/>
        <!-- sdf set -->
        <param name="sdf_map/robot_size_x" value="0.2" />
        <param name="sdf_map/robot_size_y" value="0.5" />
        <param name="sdf_map/robot_size_z" value="1.8" />   
        <param name="sdf_map/map_size_x" value="$(arg map_size_x)" />
        <param name="sdf_map/map_size_y" value="$(arg map_size_y)" />
        <param name="sdf_map/map_size_z" value="$(arg map_size_z)" />
        <param name="sdf_map/resolution" value="0.1" />
        <param name="sdf_map/local_update_range_x"  value="5.5" /> 
        <param name="sdf_map/local_update_range_y"  value="5.5" /> 
        <param name="sdf_map/local_update_range_z"  value="4.5" /> 
        <!-- obstacles_inflation（膨胀系数）原本为0.2，感觉太大，设置为0.1 -->
        <param name="sdf_map/obstacles_inflation" value="0.1" />
        <!-- sdf_map/local_bound_inflate原本0.4 -->
        <param name="sdf_map/local_bound_inflate" value="0.0"/>
        <param name="sdf_map/local_map_margin" value="10"/>
        <!-- 预定义空间的z轴最低高度 -->
        <param name="sdf_map/ground_height" value="-1"/>
        <param name="sdf_map/default_dist" value="5.0"/>
        <!-- local fusion -->
        <param name="sdf_map/p_hit" value="0.7"/>
        <param name="sdf_map/p_miss" value="0.35"/>
        <param name="sdf_map/p_min" value="0.12"/>
        <param name="sdf_map/p_max" value="0.97"/>
        <param name="sdf_map/p_occ" value="0.80"/>
        <param name="sdf_map/min_ray_length" value="0.5"/>
        <param name="sdf_map/max_ray_length" value="5.0"/>
        <!-- Keep the full PCD for SLAM/relocalization; only crop height when fusing into planning grid/SDF. -->
        <param name="sdf_map/input_min_height" value="$(arg input_min_height)"/>
        <param name="sdf_map/input_max_height" value="$(arg input_max_height)"/>
        <param name="sdf_map/virtual_ceil_height" value="3.2"/>
        <param name="sdf_map/optimistic" value="true" type="bool"/>
        <param name="sdf_map/signed_dist" value="false" type="bool"/>
        <!--  camera parameter -->
        <param name="map_ros/cx" value="384.03857421875"/>
        <param name="map_ros/cy" value="240.05001831054688"/>
        <param name="map_ros/fx" value="384.96630859375"/>
        <param name="map_ros/fy" value="327.45794677734375"/>
        <!-- depth filter -->
        <param name="map_ros/depth_filter_maxdist" value="20.0"/>
        <param name="map_ros/depth_filter_mindist" value="0.1"/>
        <param name="map_ros/depth_filter_margin" value="2"/>
        <param name="map_ros/k_depth_scaling_factor" value="1000.0"/>
        <param name="map_ros/skip_pixel" value="2"/>

        <!--  -->
        <param name="map_ros/esdf_slice_height" value="$(arg slice_height)"/>
        <param name="map_ros/visualization_truncate_height" value="2.6"/>
        <param name="map_ros/visualization_truncate_low" value="-0.5"/>
        <param name="map_ros/show_occ_time" value="false"/>
        <param name="map_ros/show_esdf_time" value="false"/>
        <param name="map_ros/show_all_map" value="false"/>
        <param name="map_ros/enable_visualization" value="$(arg enable_map_visualization)" type="bool"/>
        <param name="map_ros/publish_esdf" value="$(arg enable_map_visualization)" type="bool"/>
        <param name="map_ros/publish_update_range" value="$(arg enable_map_visualization)" type="bool"/>
        <param name="map_ros/publish_unknown" value="false"/>
        <param name="map_ros/publish_depth_cloud" value="false"/>
        <param name="map_ros/use_global_saved_map" value="false"/>
        <param name="map_ros/global_map_topic" value="/saved_map"/>
        <param name="map_ros/global_map_inflation" value="0.15"/>
        <param name="map_ros/global_map_min_height" value="0.45"/>
        <param name="map_ros/global_map_max_height" value="2.6"/>
        <param name="map_ros/frame_id" value="world"/>

        <param name="map_ros/is_simulation" value="$(arg map_simulation)" type="bool"/>
        <!-- kin astar  -->
        <param name="kinastar/resolution_astar" value="0.1"/>
        <param name="kinastar/lambda_heu" value="0.2"/>
        <param name="kinastar/allocate_num" value="100000"/>
        <!-- kin astar contorl param -->
        <param name="kinastar/horizon" value="$(arg kin_horizon)"/>
        <param name="kinastar/max_al" value="0.6"/>
        <param name="kinastar/max_aw" value="0.2"/>
        <param name="kinastar/max_theta" value="0.7"/>

        <!-- 转向代价权重（越大越走直线），仅planner=2生效 -->
        <param name="kinastar/weight_steering" value="0.3"/>
        <!-- 动态障碍物代价权重，仅planner=2(KinodynamicAstar)生效，MPC用mpc/w_risk -->
        <param name="kinastar/weight_dyn_obs" value="0.5"/>
        <param name="kinastar/pred_horizon" value="2.0"/>
        <param name="kinastar/ts" value="0.1"/>
        <param name="kinastar/distThresh_Dynamic" value="2.2"/>

        <param name="kinastar/ts_sample" value="0.5"/>
        <!-- astar set -->
        <param name="astar/horizon" value="$(arg kin_horizon)"/>
        <param name="astar/resolution_astar" value="0.1"/>
        <param name="astar/time_resolution" value="0"/>
        <param name="astar/lambda_heu" value="0.2"/>
        <param name="astar/allocate_num" value="300000"/>
        <!-- A* clearance uses only the static global map; local ESDF avoidance is handled by MPC. -->
        <param name="astar/w_clearance" value="0.8" type="double"/>
        <param name="astar/clearance_sigma" value="0.9" type="double"/>
        <param name="astar/use_static_global_map" value="$(arg use_static_global_map)" type="bool"/>
        <param name="astar/static_endpoint_clear_radius" value="$(arg static_endpoint_clear_radius)" type="double"/>
        <!-- collision set -->
        <param name="Collision/margin" value="$(arg collision_margin)"/>
        <param name="Collision/SliceHeight" value="$(arg slice_height)"/>
        <param name="Collision/use_static_global_map" value="$(arg use_static_global_map)" type="bool"/>
        <param name="Collision/use_static_global_esdf" value="$(arg use_static_global_esdf)" type="bool"/>
        <param name="Collision/static_map_pcd" value="$(arg static_map_pcd)"/>
        <param name="Collision/static_map_min_height" value="$(arg static_map_min_height)" type="double"/>
        <param name="Collision/static_map_max_height" value="$(arg static_map_max_height)" type="double"/>
        <param name="Collision/static_map_inflation" value="$(arg static_map_inflation)" type="double"/>
        <param name="Collision/static_map_min_points_per_cell" value="$(arg static_map_min_points_per_cell)" type="int"/>
        <param name="Collision/static_map_min_component_cells" value="$(arg static_map_min_component_cells)" type="int"/>
        <param name="Collision/static_require_known_region" value="$(arg static_require_known_region)" type="bool"/>
        <param name="Collision/static_known_use_enclosed_region" value="$(arg static_known_use_enclosed_region)" type="bool"/>
        <param name="Collision/static_known_min_height" value="$(arg static_known_min_height)" type="double"/>
        <param name="Collision/static_known_max_height" value="$(arg static_known_max_height)" type="double"/>
        <param name="Collision/static_known_inflation" value="$(arg static_known_inflation)" type="double"/>
        <param name="Collision/static_known_boundary_inflation" value="$(arg static_known_boundary_inflation)" type="double"/>
        <param name="Collision/global_esdf_min_height" value="$(arg global_esdf_min_height)" type="double"/>
        <param name="Collision/global_esdf_max_height" value="$(arg global_esdf_max_height)" type="double"/>
        <param name="Collision/global_esdf_query_min_height" value="$(arg global_esdf_query_min_height)" type="double"/>
        <param name="Collision/global_esdf_query_max_height" value="$(arg global_esdf_query_max_height)" type="double"/>
        <param name="Collision/global_esdf_query_step" value="$(arg global_esdf_query_step)" type="double"/>
        <param name="Collision/global_esdf_inflation" value="$(arg global_esdf_inflation)" type="double"/>
        <param name="Collision/global_esdf_safe_distance" value="$(arg global_esdf_safe_distance)" type="double"/>
        <param name="Collision/global_esdf_min_points_per_cell" value="$(arg global_esdf_min_points_per_cell)" type="int"/>
        <param name="Collision/publish_static_map_debug" value="$(arg publish_static_map_debug)" type="bool"/>
        <param name="Collision/static_map_frame" value="world"/>
        <!-- lfpc set -->
        <param name="lfpc/delta_t" value="0.07"/>
        <param name="lfpc/t_sup" value="0.35"/>
        <!-- mpc controller set -->
        <param name="mpc/horizon_steps" value="10" type="int"/>
        <param name="mpc/num_samples" value="$(arg mpc_num_samples)" type="int"/>
        <!-- MPPI温度：越小越贪心(选最优)，越大越平滑(加权平均) -->
        <param name="mpc/temperature" value="0.4" type="double"/>
        <param name="mpc/mpc_iters" value="1" type="int"/>
        <param name="mpc/max_al" value="0.6" type="double"/>
        <param name="mpc/min_al" value="0.05" type="double"/>
        <param name="mpc/max_aw" value="0.15" type="double"/>
        <param name="mpc/max_api" value="0.5236" type="double"/>
        <param name="mpc/sigma_al" value="0.10" type="double"/>
        <param name="mpc/sigma_aw" value="0.06" type="double"/>
        <param name="mpc/sigma_api" value="0.15" type="double"/>
        <!-- 代价权重。risk和goal已归一化，所有权重等效可比，改一个就有效果 -->
        <!-- 每步位移代价：惩罚绕路，保方向性 -->
        <param name="mpc/w_move" value="1.0" type="double"/>
        <!-- 转向幅度代价：惩罚|api|绝对值，越大越走直线 -->
        <param name="mpc/w_steer" value="0.5" type="double"/>
        <!-- risk已归一化：每点平均risk×权重，不再是累加值 -->
        <param name="mpc/w_risk" value="$(arg mpc_w_risk)" type="double"/>
        <param name="mpc/dynamic_hard_reject_enable" value="$(arg mpc_enable_dynamic_hard_reject)" type="bool"/>
        <!-- goal已归一化：最终距离/horizon步数×权重 -->
        <param name="mpc/w_goal" value="25.0" type="double"/>
        <!-- 转向变化率惩罚权重：越大越平滑，越小越灵活（0=不限制） -->
        <param name="mpc/w_dapi" value="1.0" type="double"/>
        <!-- hard threshold = risk_A × ratio. 越小越远离行人, 越大越敢靠近 -->
        <param name="mpc/risk_hard_threshold_ratio" value="0.4" type="double"/>
        <!-- 静态障碍物碰撞惩罚（单点），总量级=w_static×n×penalty，巨大→几乎硬约束 -->
        <param name="mpc/static_penalty" value="500.0" type="double"/>
        <param name="mpc/w_static" value="1.0" type="double"/>
        <!-- Dynamic obstacle geometry: use message size as hard safety radius input. -->
        <param name="mpc/use_dynamic_size" value="true" type="bool"/>
        <param name="mpc/dynamic_safety_margin" value="0.05" type="double"/>
        <param name="mpc/dynamic_min_radius" value="0.20" type="double"/>
        <!-- SDF排斥力权重、排斥生效距离(m)：距墙<margin时二次增长 -->
        <param name="mpc/w_prox" value="4.0" type="double"/>
        <param name="mpc/prox_margin" value="0.3" type="double"/>
        <param name="mpc/use_best" value="false" type="bool"/>
        <!-- 使用真实模式true，为false则步长和步宽不固定 -->
        <!-- Guide-cane gait model: forward motion is supplied by the user, MPC mainly optimizes steering. -->
        <param name="mpc/fix_step_params" value="true" type="bool"/>
        <param name="mpc/goal_arrival_threshold" value="0.2" type="double"/>
        <param name="mpc/fov_range" value="5.0" type="double"/>
        <param name="mpc/debug_enable" value="true" type="bool"/>
        <!-- Stop advice for guide-cane use: publish/optionally enforce stop when predicted dynamic conflict is unavoidable. -->
        <param name="mpc/stop_advice_enable" value="$(arg mpc_enable_stop_advice)" type="bool"/>
        <param name="mpc/stop_advice_enforce" value="$(arg mpc_enable_stop_enforce)" type="bool"/>
        <param name="mpc/stop_hold_time" value="0.8" type="double"/>
        <param name="mpc/stop_release_clear_time" value="0.5" type="double"/>
        <!-- Stage 2 crossing interaction. Social cost remains opt-in. -->
        <param name="mpc/interaction_enable" value="$(arg mpc_enable_interaction)" type="bool"/>
        <param name="mpc/interaction_enable_pass_behind" value="$(arg mpc_interaction_enable_pass_behind)" type="bool"/>
        <param name="mpc/interaction_enable_yield" value="$(arg mpc_interaction_enable_yield)" type="bool"/>
        <param name="mpc/interaction_enable_social_cost" value="$(arg mpc_interaction_enable_social_cost)" type="bool"/>
        <param name="mpc/interaction_w_front_pass" value="$(arg mpc_interaction_w_front_pass)" type="double"/>
        <param name="mpc/interaction_enable_behind_corridor" value="$(arg mpc_interaction_enable_behind_corridor)" type="bool"/>
        <param name="mpc/interaction_w_behind_corridor" value="$(arg mpc_interaction_w_behind_corridor)" type="double"/>
        <param name="mpc/interaction_social_corridor_width" value="$(arg mpc_interaction_social_corridor_width)" type="double"/>
        <param name="mpc/interaction_front_buffer" value="$(arg mpc_interaction_front_buffer)" type="double"/>
        <param name="mpc/interaction_target_dist_cap" value="$(arg mpc_interaction_target_dist_cap)" type="double"/>
        <param name="mpc/interaction_front_min" value="$(arg mpc_interaction_front_min)" type="double"/>
        <param name="mpc/interaction_front_max" value="$(arg mpc_interaction_front_max)" type="double"/>
        <param name="mpc/interaction_corridor_width" value="$(arg mpc_interaction_corridor_width)" type="double"/>
        <param name="mpc/interaction_cross_speed" value="$(arg mpc_interaction_cross_speed)" type="double"/>
        <param name="mpc/interaction_time_gap" value="$(arg mpc_interaction_time_gap)" type="double"/>
        <param name="mpc/interaction_min_robot_speed" value="$(arg mpc_interaction_min_robot_speed)" type="double"/>
        <param name="mpc/interaction_cpa_horizon" value="$(arg mpc_interaction_cpa_horizon)" type="double"/>
        <param name="mpc/interaction_cpa_dist" value="$(arg mpc_interaction_cpa_dist)" type="double"/>
        <param name="mpc/interaction_use_cpa_check" value="$(arg mpc_interaction_use_cpa_check)" type="bool"/>
        <param name="mpc/interaction_cross_enter_threshold" value="$(arg mpc_interaction_cross_enter_threshold)" type="double"/>
        <param name="mpc/interaction_cross_exit_threshold" value="$(arg mpc_interaction_cross_exit_threshold)" type="double"/>
        <param name="mpc/interaction_cross_confirm_frames" value="$(arg mpc_interaction_cross_confirm_frames)" type="int"/>
        <param name="mpc/interaction_cross_clear_frames" value="$(arg mpc_interaction_cross_clear_frames)" type="int"/>
        <param name="mpc/interaction_mode_confirm_frames" value="$(arg mpc_interaction_mode_confirm_frames)" type="int"/>
        <param name="mpc/interaction_candidate_latch_time" value="$(arg mpc_interaction_candidate_latch_time)" type="double"/>
        <param name="mpc/interaction_stop_release_clear_time" value="$(arg mpc_interaction_stop_release_clear_time)" type="double"/>
        <param name="mpc/interaction_post_yield_grace_time" value="$(arg mpc_interaction_post_yield_grace_time)" type="double"/>
        <param name="mpc/interaction_pass_behind_clear_time" value="$(arg mpc_interaction_pass_behind_clear_time)" type="double"/>
        <param name="mpc/interaction_pass_behind_hold_time" value="$(arg mpc_interaction_pass_behind_hold_time)" type="double"/>
        <param name="mpc/interaction_risk_low" value="$(arg mpc_interaction_risk_low)" type="double"/>
        <param name="mpc/interaction_behind_dist" value="$(arg mpc_interaction_behind_dist)" type="double"/>
        <param name="mpc/interaction_forward_bias" value="$(arg mpc_interaction_forward_bias)" type="double"/>
        <param name="mpc/interaction_target_front_min" value="$(arg mpc_interaction_target_front_min)" type="double"/>
        <param name="mpc/interaction_target_front_max" value="$(arg mpc_interaction_target_front_max)" type="double"/>
        <param name="mpc/interaction_target_lateral_max" value="$(arg mpc_interaction_target_lateral_max)" type="double"/>
        <param name="mpc/interaction_target_ped_clearance" value="$(arg mpc_interaction_target_ped_clearance)" type="double"/>
        <param name="mpc/nominal_al" value="$(arg user_step_length)" type="double"/>
        <param name="mpc/nominal_aw" value="0.0" type="double"/>
        <param name="mpc/nominal_api" value="0.0" type="double"/>
        <param name="mpc/risk_tau" value="0.8" type="double"/>
        <param name="mpc/risk_A" value="5.0" type="double"/>
        <param name="mpc/risk_sigma_x" value="0.6" type="double"/>
        <param name="mpc/risk_sigma_y" value="$(arg mpc_risk_sigma_y)" type="double"/>
        <param name="mpc/risk_cutoff" value="3.0" type="double"/>
        <!-- 光晕：硬核心外的低幅包络。halo_scale=0关闭(纯高斯)，scale>0时包络宽度=core_sigma*scale，ratio=峰值/A -->
        <param name="mpc/risk_halo_scale" value="2.0" type="double"/>
        <param name="mpc/risk_halo_ratio" value="0.12" type="double"/>
        <!-- CPA/TTC dynamic conflict risk: improves crossing-pedestrian avoidance without increasing MPC horizon. -->
        <param name="mpc/risk_cpa_enable" value="$(arg mpc_enable_cpa)" type="bool"/>
        <param name="mpc/risk_cpa_weight" value="$(arg mpc_cpa_weight)" type="double"/>
        <param name="mpc/risk_cpa_sigma_d" value="0.65" type="double"/>
        <param name="mpc/risk_cpa_tau" value="1.0" type="double"/>
        <param name="mpc/risk_cpa_time_horizon" value="2.0" type="double"/>
        <param name="mpc/risk_cpa_cutoff_dist" value="3.0" type="double"/>

        <!-- trajectory optimization 代价权重 -->
        <!-- lambda1: 平滑度, lambda2: 碰撞, lambda3: 可行性, lambda4: 拟合, lambda7: 动力学 -->
        <param name="optimization/lambda1" value="10.0" type="double"/>
        <param name="optimization/lambda2" value="5.0" type="double"/>
        <param name="optimization/lambda3" value="0.00001" type="double"/>
        <param name="optimization/lambda4" value="0.01" type="double"/>
        <param name="optimization/lambda7" value="100.0" type="double"/>
        <param name="optimization/dist0" value="0.4" type="double"/>
        <param name="optimization/max_vel" value="3.0" type="double"/>
        <param name="optimization/max_acc" value="2.0" type="double"/>

        <param name="optimization/algorithm1" value="15" type="int"/>
        <param name="optimization/algorithm2" value="11" type="int"/>

        <param name="optimization/max_iteration_num1" value="2" type="int"/>
        <param name="optimization/max_iteration_num2" value="300" type="int"/>
        <param name="optimization/max_iteration_num3" value="200" type="int"/>
        <param name="optimization/max_iteration_num4" value="200" type="int"/>

        <param name="optimization/max_iteration_time1" value="0.0001" type="double"/>
        <param name="optimization/max_iteration_time2" value="0.005" type="double"/>
        <param name="optimization/max_iteration_time3" value="0.003" type="double"/>
        <param name="optimization/max_iteration_time4" value="0.003" type="double"/>

        <param name="optimization/order" value="3" type="int"/>

        <param name="bspline/limit_vel" value="3.0" type="double"/>
        <param name="bspline/limit_acc" value="2.0" type="double"/>
        <param name="bspline/limit_ratio" value="1.1" type="double"/>

        <param name="bspline/limit_vel" value="3.0" type="double"/>
        <param name="bspline/limit_acc" value="2.0" type="double"/>
        <param name="bspline/limit_ratio" value="1.1" type="double"/>

    </node>

</launch>
