+// Status updates are latched and emitted on transition only, never every cycle.
+// Times describe the sample at that transition, not a continuously fresh heartbeat.
+void Simulator::reportGuard(const std::string& status, const ros::Time& now,
+                            const ros::Time& stamp, double age) {
+  if (status == guard_status_) return;
+  guard_status_ = status;
+  std::ostringstream text;
+  text << std::setprecision(12) << "state=" << status << " started=" << robot_started_
+       << " paused=" << paused_ << " sample_time=" << now.toSec()
+       << " tf_stamp=" << stamp.toSec() << " age=" << age;
+  std_msgs::String msg; msg.data = text.str();
+  pub_guard_status_.publish(msg);
+  ROS_INFO_STREAM("[robot_guard] " << msg.data);
+}
+
+bool Simulator::robotInputReady() {
+  // Use the SAME lookup result for comparison and later integration. Sampling
+  // now before lookup falsely labels a concurrent, valid TF update as future.
+  tf::StampedTransform transform;
+  bool found = true;
+  try {
+    transform_listener_->lookupTransform(frame_id_, robot_base_frame_id_, ros::Time(0), transform);
+  } catch (const tf::TransformException&) { found = false; }
+  const ros::Time now = ros::Time::now();
+  const double age = found ? (now-transform.stamp_).toSec() : std::numeric_limits<double>::quiet_NaN();
+  std::string reason;
+  if (!last_guard_time_.isZero() && now < last_guard_time_) reason = "CLOCK_ROLLBACK";
+  else if (!robot_) reason = "ROBOT_MISSING";
+  else if (now.isZero() || !found || transform.stamp_.isZero()) reason = "TF_MISSING";
+  else if (!std::isfinite(transform.getOrigin().x()) || !std::isfinite(transform.getOrigin().y())) reason = "TF_INVALID";
+  else if (age < 0.) reason = "TF_FUTURE";
+  else if (age > .5) reason = "TF_STALE";
+  last_guard_time_ = now;
+  // Before the first actual integration, paused/readiness probes cannot start
+  // the running-loss contract. After starting, even a deliberate re-pause does
+  // not erase history: loss while paused remains latched until restart.
+  if (!reason.empty() && robot_started_ && !robot_failed_) {
+    robot_failed_ = true; guard_latch_reason_ = reason;
+  }
+  if (robot_failed_) {
+    reportGuard("LATCHED_"+guard_latch_reason_,now,found?transform.stamp_:ros::Time(),age);
+    return false;
+  }
+  if (!reason.empty()) {
+    reportGuard((paused_?"PAUSED_WAITING_":"WAITING_INITIAL_")+reason,now,found?transform.stamp_:ros::Time(),age);
+    return false;
+  }
+  guarded_robot_transform_ = transform;
+  reportGuard(paused_?"PAUSED_READY":"RUNNING",now,transform.stamp_,age);
+  return true;
+}
