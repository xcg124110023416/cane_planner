+bool Simulator::editScene(pedsim_srvs::EditScene::Request& request,
+                          pedsim_srvs::EditScene::Response& response) {
+  auto snapshot = [&]() {
+    response.revision = scene_revision_;
+    response.running = scene_editor_running_ && !paused_ && !robot_failed_;
+    for (const auto& person : edited_pedestrians_) {
+      response.agent_ids.push_back(person.agent->getId());
+      geometry_msgs::Pose2D pose;
+      pose.x = person.agent->getx(); pose.y = person.agent->gety();
+      pose.theta = std::hypot(person.agent->getvx(), person.agent->getvy()) > 1e-6 ?
+          std::atan2(person.agent->getvy(), person.agent->getvx()) : person.start.theta;
+      response.poses.push_back(pose);
+      response.phases.push_back(!scene_editor_running_ && person.phase != "finished" && person.phase != "waiting" ? "paused" : person.phase);
+    }
+  };
+  auto reject = [&](const std::string& message) {
+    response.success = false; response.message = message; snapshot(); return true;
+  };
+  if (!scene_editor_enabled_) return reject("Scene editor disabled");
+  if (request.command == "state") {
+    if (robot_failed_) return reject("Robot input fault: restart this round");
+    response.success = true; snapshot(); return true;
+  }
+  // No command is allowed to clear the existing freshness latch.
+  if (robot_failed_) return reject("Robot input fault: restart this round");
+  if (request.expected_revision != scene_revision_) return reject("Scene revision changed; refresh before editing");
+  if (request.command == "replace") {
+    const size_t count = request.starts.size();
+    if (count > 5 || request.goals.size() != count || request.desired_speeds.size() != count || request.end_behaviors.size() != count)
+      return reject("Scene arrays must match and contain at most five people");
+    for (size_t i = 0; i < count; ++i) {
+      const auto& start = request.starts[i]; const auto& goal = request.goals[i];
+      const double speed = request.desired_speeds[i]; const auto& behavior = request.end_behaviors[i];
+      for (double coordinate : {start.x, start.y, goal.x, goal.y})
+        if (!std::isfinite(coordinate) || std::abs(coordinate) >= 14.5) return reject("Endpoint outside blank arena clearance");
+      if (!std::isfinite(start.theta) || !std::isfinite(goal.z) || std::abs(goal.z) > 1e-6 ||
+          !std::isfinite(speed) || speed < 0. || speed > 3. ||
+          (speed > 0. && std::hypot(start.x-goal.x, start.y-goal.y) <= .4) ||
+          (behavior != "stop" && behavior != "return" && behavior != "repeat")) return reject("Invalid pedestrian settings");
+      for (size_t j = 0; j < i; ++j)
+        if (std::hypot(start.x-request.starts[j].x, start.y-request.starts[j].y) < .55)
+          return reject("Pedestrian starts must be at least 0.55 m apart");
+    }
+    // Ordinary agents are removed from the neighbor tree before deletion. Walls
+    // and the externally controlled robot, including its guard history, survive.
+    const auto old_agents = SCENE.getAgents();
+    for (Agent* agent : old_agents) if (agent->getType() != Ped::Tagent::ROBOT) {
+      AgentStateMachine* state_machine = agent->getStateMachine();
+      SCENE.removeAgent(agent); delete state_machine; // upstream Agent does not own-delete this object
+    }
+    edited_pedestrians_.clear();
+    const auto old_waypoints = SCENE.getWaypoints();
+    for (Waypoint* waypoint : old_waypoints) SCENE.removeWaypoint(waypoint);
+    ++scene_revision_; scene_editor_running_ = false;
+    for (size_t i = 0; i < count; ++i) {
+      const auto& start = request.starts[i]; const auto& goal = request.goals[i];
+      auto* waypoint = new AreaWaypoint(QString("editor_%1_%2").arg(qulonglong(scene_revision_)).arg(qulonglong(i)), goal.x, goal.y, .2);
+      SCENE.addWaypoint(waypoint);
+      auto* agent = new Agent(); agent->setPosition(start.x, start.y);
+      agent->setvx(0.); agent->setvy(0.); agent->setVmax(0.); agent->addWaypoint(waypoint);
+      SCENE.addAgent(agent);
+      edited_pedestrians_.push_back({agent, waypoint, start, goal, request.desired_speeds[i], request.end_behaviors[i], "waiting"});
+    }
+  } else if (request.command == "start" || request.command == "pause") {
+    ++scene_revision_; scene_editor_running_ = request.command == "start";
+    for (auto& person : edited_pedestrians_) {
+      if (scene_editor_running_ && person.phase == "waiting") person.phase = "walking";
+      if (!scene_editor_running_) { person.agent->setVmax(0.); person.agent->setvx(0.); person.agent->setvy(0.); }
+    }
+  } else return reject("Unknown scene command");
+  response.success = true; response.message = "OK"; snapshot(); return true;
+}
+
+void Simulator::advanceEditedPedestrians() {
+  for (auto& person : edited_pedestrians_) {
+    if (scene_editor_running_ && person.phase != "finished") {
+      const bool returning = person.phase == "returning";
+      const double x = returning ? person.start.x : person.goal.x;
+      const double y = returning ? person.start.y : person.goal.y;
+      if (std::hypot(person.agent->getx()-x, person.agent->gety()-y) <= .2) {
+        if (person.behavior == "repeat" || (person.behavior == "return" && !returning)) {
+          person.phase = returning ? "walking" : "returning";
+          person.waypoint->setPosition(returning ? person.goal.x : person.start.x,
+                                       returning ? person.goal.y : person.start.y);
+        } else person.phase = "finished";
+      }
+    }
+    const bool moving = scene_editor_running_ && person.phase != "finished";
+    person.agent->setVmax(moving ? person.speed : 0.);
+    if (!moving) { person.agent->setvx(0.); person.agent->setvy(0.); }
+  }
+}
